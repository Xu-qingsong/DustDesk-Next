<UserControl x:Class="DustDesk.Next.Widgets.MonitorWidgetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <StackPanel Visibility="{Binding ShowCpu, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="CPU" /><TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontFamily="Consolas" /></Grid><ProgressBar Value="{Binding CpuPercent}" Height="5" Margin="0,4,0,10" /></StackPanel>
        <StackPanel Visibility="{Binding ShowMemory, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="内存" /><TextBlock Grid.Column="1" Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" FontFamily="Consolas" /></Grid><ProgressBar Value="{Binding MemoryPercent}" Height="5" Margin="0,4,0,10" /></StackPanel>
        <TextBlock Text="{Binding DownloadText, StringFormat=下载 {0}}" Visibility="{Binding ShowDownload, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock Text="{Binding UploadText, StringFormat=上传 {0}}" Visibility="{Binding ShowUpload, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4" />
        <TextBlock Text="{Binding DiskIoText, StringFormat=磁盘 {0}}" Visibility="{Binding ShowDiskIo, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4" />
        <StackPanel Visibility="{Binding ShowDiskSpace, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4">
            <TextBlock Text="空间" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DiskSpaceStatusText}" Visibility="{Binding ShowDiskSpaceStatus, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding DiskSpaces}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DriveName}" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SpaceText}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceText}" />
                            </Grid>
                            <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="4" Margin="0,3,0,0" AutomationProperties.Name="{Binding DriveName, StringFormat={}{0} 已用空间}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding PingText, StringFormat=延迟 {0}}" Visibility="{Binding ShowPing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4" />
        <TextBlock Text="{Binding UptimeText, StringFormat=运行 {0}}" Visibility="{Binding ShowUptime, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
