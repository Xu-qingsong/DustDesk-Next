<UserControl x:Class="DustDesk.Next.Widgets.OrganizerWidgetView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop">
    <TabControl ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"
                Style="{StaticResource WidgetTabControlStyle}"
                ItemContainerStyle="{StaticResource WidgetTabItemStyle}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                BorderThickness="0"
                Background="Transparent">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4"
                                    Padding="7"
                                    Tag="{Binding DataContext, ElementName=Root}"
                                    Command="{Binding DataContext.OpenEntryCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="{Binding Path}">
                                <Button.ContextMenu>
                                    <ContextMenu FontFamily="Segoe UI Variable, Microsoft YaHei UI"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="打开" Command="{Binding Tag.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="恢复到桌面" Command="{Binding Tag.RestoreAnyEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel>
                                    <Image Source="{Binding Path, Converter={StaticResource FileIconConverter}}"
                                           Width="{Binding DataContext.IconSize, ElementName=Root}"
                                           Height="{Binding DataContext.IconSize, ElementName=Root}" />
                                    <TextBlock Text="{Binding Name}"
                                               Visibility="{Binding DataContext.ShowNames, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               MaxWidth="110"
                                               Margin="0,5,0,0"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
