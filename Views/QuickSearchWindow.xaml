<ui:FluentWindow x:Class="DustDesk.Next.Views.QuickSearchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DustDesk 搜索"
                 Width="680"
                 Height="480"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="快速搜索"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="32"
                    Height="32"
                    Content="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons"
                    Style="{StaticResource IconButtonStyle}"
                    Click="Close_OnClick"
                    ToolTip="关闭"
                    AutomationProperties.Name="关闭快速搜索" />
        </Grid>

        <TextBox x:Name="QueryBox"
                 Grid.Row="1"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource SearchInputStyle}"
                 FontSize="15"
                 Margin="0,12,0,10"
                 AutomationProperties.Name="快速搜索内容" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Results}"
                 MouseDoubleClick="Results_OnMouseDoubleClick"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Path, Converter={StaticResource FileIconConverter}}"
                               Width="24"
                               Height="24" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Path}"
                                   Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="10,0"
                                   ToolTip="{Binding Path}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</ui:FluentWindow>
