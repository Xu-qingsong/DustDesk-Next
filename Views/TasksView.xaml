<UserControl x:Class="DustDesk.Next.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DustDesk.Next.ViewModels">
    <Grid Margin="34,30,34,34" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="任务" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="按日期记录、提醒并完成每天的事项。" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="前一天" Command="{Binding PreviousDayCommand}" />
                <Button Content="今天" Command="{Binding TodayCommand}" Margin="6,0" />
                <Button Content="后一天" Command="{Binding NextDayCommand}" />
                <DatePicker SelectedDate="{Binding SelectedDate}" Margin="8,0,0,0" Width="160" Height="32" />
                <ComboBox SelectedValue="{Binding ListMode}" SelectedValuePath="Tag" Width="120" Margin="8,0,0,0"><ComboBoxItem Content="按日期" Tag="{x:Static local:TaskListMode.SelectedDate}" /><ComboBoxItem Content="全部" Tag="{x:Static local:TaskListMode.All}" /><ComboBoxItem Content="未完成" Tag="{x:Static local:TaskListMode.Open}" /><ComboBoxItem Content="逾期" Tag="{x:Static local:TaskListMode.Overdue}" /></ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource MainGlassPanelStyle}" Padding="0" Margin="0,24,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="全部事项" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock Text="{Binding FilteredTodos.Count, StringFormat={}{0} 项}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedDateText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddTodo_OnClick"
                            AutomationProperties.Name="添加任务">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" />
                            <TextBlock Text="添加任务" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="当天暂无任务" Style="{StaticResource CaptionStyle}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        <Button Content="添加任务" Click="AddTodo_OnClick" Margin="0,14,0,0" HorizontalAlignment="Center" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredTodos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding FilteredTodos}"
                             SelectedItem="{Binding SelectedTodo}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="TodoList_OnMouseDoubleClick">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredTodos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource CanvasBrush}" /></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource PrimarySoftBrush}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,1" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="20,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Tag}" Foreground="{Binding TagColorArgb, Converter={StaticResource ArgbToBrushConverter}}" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding ReminderSummary}" Style="{StaticResource CaptionStyle}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="&#xE70F;"
                                            FontFamily="Segoe Fluent Icons"
                                            Click="EditTodo_OnClick"
                                            Tag="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="编辑任务"
                                            AutomationProperties.Name="编辑任务" />
                                    <Button Grid.Column="3"
                                            Content="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons"
                                            Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="删除任务"
                                            AutomationProperties.Name="删除任务" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
