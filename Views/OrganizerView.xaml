<UserControl x:Class="DustDesk.Next.Views.OrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DustDesk.Next.Controls"
             AllowDrop="True" Drop="OnExternalDrop">
    <UserControl.Resources>
        <Style x:Key="OrganizerCategoryRowStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionRail"
                                        Width="3"
                                        Margin="0,7,0,7"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        CornerRadius="0,2,2,0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="SelectionRail" Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrganizerIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleRoot" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleRoot" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="ToggleRoot" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleRoot" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrganizerPinToggleStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource OrganizerIconToggleStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,30,34,34" MaxWidth="1240" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="桌面收纳" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="把桌面文件移入分类，需要时一键恢复到桌面。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新桌面" Command="{Binding RefreshDesktopCommand}" Padding="16,9" />
                    <Button Content="撤销上次整理" Command="{Binding UndoLastBatchCommand}" Padding="16,9" Margin="8,0,0,0" />
                    <Button Command="{Binding SmartOrganizeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"
                            Padding="15,0"
                            AutomationProperties.Name="智能收纳桌面文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="智能收纳" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSmartOrganizing}" Value="True">
                                                <Setter Property="Text" Value="正在收纳" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ProgressBar IsIndeterminate="True"
                             Height="2"
                             Width="118"
                             Margin="0,5,0,0"
                             HorizontalAlignment="Right"
                             Visibility="{Binding IsSmartOrganizing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding SmartOrganizeStatus}"
                           MaxWidth="440"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SmartOrganizeStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#FFF1E8" BorderBrush="#F0C59F" BorderThickness="1" CornerRadius="5" Padding="14,9" Margin="0,20,0,14"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" /></Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource MainGlassPanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分类"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="添加"
                                Command="{Binding AddCategoryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                ToolTip="添加分类" />
                        <Button Grid.Column="2"
                                Content="↑"
                                Command="{Binding MoveCategoryUpCommand}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="上移分类" />
                        <Button Grid.Column="3"
                                Content="↓"
                                Command="{Binding MoveCategoryDownCommand}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="下移分类" />
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MainGlassInputStyle}"
                             Margin="16,0,16,10" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             ItemContainerStyle="{StaticResource OrganizerCategoryRowStyle}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="15"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <Grid Grid.Column="1" Margin="7,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Items.Count, StringFormat={}{0} 项}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="7,0,0,0" />
                                    </Grid>
                                    <ToggleButton Grid.Column="2"
                                                  IsChecked="{Binding IsSelectedForWidget}"
                                                  Style="{StaticResource OrganizerPinToggleStyle}"
                                                  ToolTip="加入或移出组合组件"
                                                  AutomationProperties.Name="选择此分类用于组合组件">
                                        <TextBlock Text="&#xE840;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                    </ToggleButton>
                                    <Button Grid.Column="3"
                                            Command="{Binding DataContext.ToggleCategoryCollapseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="展开或收起分类内容"
                                            AutomationProperties.Name="展开或收起分类内容">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE70D;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                            <Setter Property="Text" Value="&#xE76C;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="12,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding MergeTarget}" DisplayMemberPath="Name" Height="34" /><Button Grid.Column="1" Content="合并" Command="{Binding MergeSelectedCategoryCommand}" Margin="6,0,0,0" /></Grid><Button Content="固定所选分类组合" Command="{Binding PinCategoryGroupCommand}" Margin="0,8,0,0" /><ItemsControl ItemsSource="{Binding WidgetGroups}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Content="显示" Command="{Binding DataContext.ShowWidgetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="7,3" /><Button Grid.Column="2" Content="删除" Command="{Binding DataContext.DeleteWidgetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="7,3" Margin="4,0,0,0" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <Button Grid.Row="4" Content="删除并恢复内容" Command="{Binding DeleteCategoryCommand}" Margin="12" Padding="10,8" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MainGlassPanelStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedCategory.Name, UpdateSourceTrigger=LostFocus}" FontSize="18" FontWeight="SemiBold" BorderThickness="0" Padding="0" /><TextBlock Grid.Column="1" Text="{Binding SelectedCategory.Items.Count, StringFormat={}{0} 项}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,0" /><Button Grid.Column="2" Content="固定" Command="{Binding PinSelectedCategoryCommand}" Padding="10,6" /></Grid><ListView Grid.Row="1" ItemsSource="{Binding SelectedCategory.Items}" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListView.Style><Style TargetType="ListView"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedCategory.IsCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListView.Style><ListView.ItemTemplate><DataTemplate><Grid Margin="16,9"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:AsyncFileIcon Path="{Binding Path}" Width="24" Height="24" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="↑" Command="{Binding DataContext.MoveEntryUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="28" Padding="0" ToolTip="上移" /><Button Grid.Column="3" Content="↓" Command="{Binding DataContext.MoveEntryDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="28" Padding="0" Margin="4,0" ToolTip="下移" /><Button Grid.Column="4" Content="打开" Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6" /><Button Grid.Column="5" Content="更多" Command="{Binding DataContext.ShowEntryMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6" Margin="4,0" /><Button Grid.Column="6" Content="恢复" Command="{Binding DataContext.RestoreEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,6" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            <Border Grid.Column="4" Style="{StaticResource MainGlassPanelStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="当前桌面" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="选择分类后，将项目移入分类" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Content="桌面菜单" Command="{Binding ShowDesktopMenuCommand}" Padding="9,5" /></Grid><ListView Grid.Row="1" ItemsSource="{Binding DesktopEntries}" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid Margin="16,9"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:AsyncFileIcon Path="{Binding Path}" Width="24" Height="24" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="更多" Command="{Binding DataContext.ShowEntryMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="9,5" /><Button Grid.Column="3" Content="收纳" Command="{Binding DataContext.MoveDesktopEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,6" Margin="6,0,0,0" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
