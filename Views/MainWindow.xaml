<ui:FluentWindow x:Class="DustDesk.Next.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Workspace.DisplayName}"
                 Icon="/DustDesk.Next;component/Assets/DustDeskLogo.png"
                 Width="1320"
                 Height="840"
                 MinWidth="1024"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="MainGlassChromeBrush" Color="#F4F7FAFA" />
        <SolidColorBrush x:Key="MainGlassHoverBrush" Color="#E8EEEC" />
        <SolidColorBrush x:Key="MainGlassSelectedBrush" Color="#E61C2525" />
        <SolidColorBrush x:Key="MainGlassLineBrush" Color="#D7FFFFFF" />

        <Style x:Key="TopNavigationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="58" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationRoot" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <Border x:Name="ActiveLine" Height="3" Width="22" VerticalAlignment="Bottom"
                                        Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationRoot" Property="Background" Value="{StaticResource MainGlassHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="NavigationRoot" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="NavigationRoot" Property="Background" Value="{StaticResource MainGlassSelectedBrush}" />
                                <Setter TargetName="ActiveLine" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="GlassMoreMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemRoot" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemRoot" Property="Background" Value="#B8FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MenuItemRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="MenuItemRoot" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="#EEF2F4F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Background="{StaticResource MainGlassChromeBrush}"
                BorderBrush="{StaticResource MainGlassLineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="14,7,8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Margin="4,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="7" Background="Transparent" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="/DustDesk.Next;component/Assets/DustDeskLogo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Workspace.DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="本地工作台" Style="{StaticResource CaptionStyle}" FontSize="10" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding PrimaryNavigationItems}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource TopNavigationButtonStyle}"
                                    ToolTip="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="15"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="11"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MoreButton"
                            Width="58" Height="58" MinHeight="58" Margin="2,0,0,0" Padding="0"
                            ToolTip="更多功能" AutomationProperties.Name="更多功能"
                            Click="More_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecondaryNavigationSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource MainGlassSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                            <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Row="1" Text="更多" FontSize="11"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" MinWidth="190" Padding="4" Placement="Bottom"
                                         Background="#F2F7F9F9" BorderBrush="#AFFFFFFF" BorderThickness="1"
                                         ItemsSource="{Binding PlacementTarget.DataContext.SecondaryNavigationItems, RelativeSource={RelativeSource Self}}">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="4">
                                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#26343A" /></Border.Effect>
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource GlassMoreMenuItemStyle}">
                                        <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                                <ContextMenu.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="158">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ContextMenu.ItemTemplate>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="218" Height="34" Margin="0,0,7,0" VerticalAlignment="Center"
                            Background="#F2FFFFFF" BorderBrush="{StaticResource SearchBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Cursor="Hand" MouseLeftButtonDown="QuickSearch_OnMouseLeftButtonDown"
                            ToolTip="打开快速搜索（Ctrl+K）">
                        <Grid Margin="9,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,7,0" />
                            <TextBlock Grid.Column="1" Text="搜索文件、任务和项目" TextWrapping="NoWrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <Border Grid.Column="2" Height="20" Background="#72E4E9E9" CornerRadius="3" Padding="5,0">
                                <TextBlock Text="Ctrl K" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe Fluent Icons" Click="Minimize_OnClick" ToolTip="收起" Style="{StaticResource WindowCommandButtonStyle}" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe Fluent Icons" Click="Maximize_OnClick" ToolTip="全屏" Style="{StaticResource WindowCommandButtonStyle}" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Click="Close_OnClick" ToolTip="关闭到托盘" Style="{StaticResource WindowCommandButtonStyle}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,10,14,14"
                Background="#ECFFFFFF" BorderBrush="#D8FFFFFF" BorderThickness="1" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#23333B" />
            </Border.Effect>
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>

        <Border Grid.Row="1" Panel.ZIndex="20" VerticalAlignment="Bottom" Margin="28,0,28,28"
                Background="#EEFCE8E8" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Workspace.SaveErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource DangerBrush}" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="{Binding Workspace.SaveErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="重试保存" Command="{Binding Workspace.RetrySaveCommand}" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
