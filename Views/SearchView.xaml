<UserControl x:Class="DustDesk.Next.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30,34,34" MaxWidth="1080" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="搜索" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="查找桌面、开始菜单、项目路径和自定义目录。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" /></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource MainGlassPanelStyle}" Margin="0,20,0,12" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="4,0,10,0" /><TextBox Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchInputStyle}" FontSize="14" ToolTip="输入文件、应用或项目名称" AutomationProperties.Name="搜索内容" /><TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" Margin="12,0,4,0" /></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource MainGlassPanelStyle}" Padding="0"><ListView ItemsSource="{Binding Results}" MouseDoubleClick="Results_OnMouseDoubleClick" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><Grid Margin="18,11"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Image Source="{Binding Path, Converter={StaticResource FileIconConverter}}" Width="26" Height="26" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Grid.Column="2" Text="{Binding Path}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="12,0" ToolTip="{Binding Path}" /><TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource CaptionStyle}" /><Button Grid.Column="4" Content="打开" Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="14,7" /><Button Grid.Column="5" Content="更多" Command="{Binding DataContext.ShowResultMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,7" Margin="6,0,0,0" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
    </Grid>
</UserControl>
