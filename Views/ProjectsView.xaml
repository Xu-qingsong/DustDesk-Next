<UserControl x:Class="DustDesk.Next.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30,34,34" MaxWidth="1240" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="项目" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="按项目、阶段和子事项推进工作。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MainGlassInputStyle}" ToolTip="项目名称" /><Button Grid.Column="2" Content="新建项目" Command="{Binding AddProjectCommand}" Style="{StaticResource PrimaryButtonStyle}" /></Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource MainGlassPanelStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="项目列表" Style="{StaticResource SectionTitleStyle}" Margin="16" /><ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" BorderThickness="0" HorizontalContentAlignment="Stretch" /><Button Grid.Row="2" Content="删除项目" Command="{Binding DeleteProjectCommand}" CommandParameter="{Binding SelectedProject}" Margin="14" Padding="12,8" /></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource MainGlassPanelStyle}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="19" FontWeight="SemiBold" BorderThickness="0" Padding="0" /><Button Grid.Column="1" Content="固定" Command="{Binding PinSelectedProjectCommand}" Padding="10,6" /><Button Grid.Column="2" Content="选择路径" Command="{Binding ChooseProjectPathCommand}" Padding="10,6" Margin="6,0,0,0" /><Button Grid.Column="3" Content="打开" Command="{Binding OpenProjectPathCommand}" Padding="10,6" Margin="6,0,0,0" /></Grid>
                <TextBlock Grid.Row="1" Text="{Binding SelectedProject.ProjectPath}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="0,8,0,14" />
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewPhaseTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MainGlassInputStyle}" ToolTip="阶段名称" /><Button Grid.Column="2" Content="添加阶段" Command="{Binding AddPhaseCommand}" Style="{StaticResource PrimaryButtonStyle}" /></Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding SelectedProject.Phases}" SelectedItem="{Binding SelectedPhase}" Margin="0,14,0,0" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" /></StackPanel><ProgressBar Grid.Column="1" Value="{Binding CalculatedProgress, Mode=OneWay}" Height="6" VerticalAlignment="Center" /><Button Grid.Column="2" Content="任务" Command="{Binding DataContext.CreateTaskFromPhaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" Margin="6,0,0,0" /><Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Command="{Binding DataContext.DeletePhaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid></Border>
            <Border Grid.Column="4" Style="{StaticResource MainGlassPanelStyle}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="阶段详情" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="名称" Style="{StaticResource CaptionStyle}" Margin="0,16,0,6" /><TextBox Text="{Binding SelectedPhase.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MainGlassInputStyle}" />
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="状态" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding SelectedPhase.StatusValues}" SelectedItem="{Binding SelectedPhase.Status}" Height="34" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="自定义进度（-1 自动）" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" /><TextBox Text="{Binding SelectedPhase.ProgressPercent}" Style="{StaticResource MainGlassInputStyle}" /></StackPanel></Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding SelectedPhase.StartDate}" Height="34" /><DatePicker Grid.Column="2" SelectedDate="{Binding SelectedPhase.EndDate}" Height="34" /></Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="选择阶段路径" Command="{Binding ChoosePhasePathCommand}" Padding="10,6" /><Button Content="打开路径" Command="{Binding OpenPhasePathCommand}" Padding="10,6" Margin="6,0,0,0" /></StackPanel><TextBlock Text="{Binding SelectedPhase.ProjectPath}" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
                <Separator Margin="0,16" /><TextBlock Text="子事项" Style="{StaticResource SectionTitleStyle}" /><Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MainGlassInputStyle}" /><Button Grid.Column="2" Content="添加" Command="{Binding AddSubtaskCommand}" Style="{StaticResource PrimaryButtonStyle}" /></Grid>
                <ItemsControl ItemsSource="{Binding SelectedPhase.Subtasks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsCompleted}" Margin="0,0,9,0" /><StackPanel Grid.Column="1"><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" /><TextBlock Text="{Binding FilePath}" Style="{StaticResource CaptionStyle}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="2" Content="关联" Command="{Binding DataContext.ChooseSubtaskFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" /><Button Grid.Column="3" Content="打开" Command="{Binding DataContext.OpenSubtaskFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" Margin="4,0" /><Button Grid.Column="4" Content="任务" Command="{Binding DataContext.CreateTaskFromSubtaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" Margin="4,0" /><Button Grid.Column="5" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Command="{Binding DataContext.DeleteSubtaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
