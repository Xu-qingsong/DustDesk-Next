<ui:FluentWindow x:Class="DustDesk.Next.Views.TaskEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="任务"
                 Width="560"
                 Height="610"
                 MinWidth="520"
                 MinHeight="580"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Loaded="Window_OnLoaded">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock x:Name="DialogTitle" Text="添加任务" Style="{StaticResource PageTitleStyle}" FontSize="22" />
                <TextBlock x:Name="TaskDateText" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons"
                    Style="{StaticResource IconButtonStyle}"
                    Click="Cancel_OnClick"
                    ToolTip="关闭"
                    AutomationProperties.Name="关闭任务弹窗" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="标题" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource MainGlassInputStyle}"
                     MaxLength="160"
                     AutomationProperties.Name="任务标题" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="标签" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <ComboBox x:Name="TagBox"
                      IsEditable="True"
                      Height="34"
                      Padding="8,4"
                      MaxDropDownHeight="180"
                      AutomationProperties.Name="任务标签" />
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="14"
                Background="{StaticResource SurfaceMutedBrush}"
                CornerRadius="4">
            <StackPanel>
                <CheckBox x:Name="ReminderEnabledBox"
                          Content="设置提醒"
                          FontWeight="SemiBold"
                          Checked="ReminderEnabled_OnChanged"
                          Unchecked="ReminderEnabled_OnChanged" />
                <Grid x:Name="ReminderFields" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="ReminderDatePicker"
                                Height="34"
                                AutomationProperties.Name="提醒日期" />
                    <ComboBox x:Name="ReminderTimeBox"
                              Grid.Column="2"
                              IsEditable="True"
                              Height="34"
                              AutomationProperties.Name="提醒时间" />
                    <ComboBox x:Name="RepeatBox"
                              Grid.Column="4"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              Height="34"
                              AutomationProperties.Name="重复提醒" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="备注" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="NoteBox"
                     Style="{StaticResource MainGlassInputStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="110"
                     MaxLength="2000"
                     AutomationProperties.Name="任务备注" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Foreground="{StaticResource DangerBrush}"
                   Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button x:Name="SaveButton"
                    Content="添加任务"
                    IsDefault="True"
                    MinWidth="96"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
