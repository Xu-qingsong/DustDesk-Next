<UserControl x:Class="DustDesk.Next.Views.StatsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="34,30,34,34" MaxWidth="1080" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="统计分析" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="查看工作记录和项目推进情况。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" /></StackPanel><Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" /></Grid><Grid Grid.Row="1" Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource MainGlassPanelStyle}"><StackPanel><TextBlock Text="任务完成率" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding TaskCompletionPercent, StringFormat={}{0:0}%}" FontFamily="Consolas" FontSize="32" Margin="0,12,0,7" /><ProgressBar Value="{Binding TaskCompletionPercent, Mode=OneWay}" Height="7" /><TextBlock Text="{Binding TaskCompleted, StringFormat=已完成 {0} 项}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource MainGlassPanelStyle}"><StackPanel><TextBlock Text="项目阶段完成率" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding PhaseCompletionPercent, StringFormat={}{0:0}%}" FontFamily="Consolas" FontSize="32" Margin="0,12,0,7" /><ProgressBar Value="{Binding PhaseCompletionPercent, Mode=OneWay}" Height="7" /><TextBlock Text="{Binding PhaseDone, StringFormat=已完成 {0} 个阶段}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0" /></StackPanel></Border></Grid><UniformGrid Grid.Row="2" Columns="6"><Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="桌面分类" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding DesktopCategoryTotal}" FontFamily="Consolas" FontSize="24" Margin="0,7,0,0" /></StackPanel></Border><Border Style="{StaticResource MainGlassPanelStyle}" Margin="5,0"><StackPanel><TextBlock Text="项目" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding ProjectTotal}" FontFamily="Consolas" FontSize="24" Margin="0,7,0,0" /></StackPanel></Border><Border Style="{StaticResource MainGlassPanelStyle}" Margin="5,0"><StackPanel><TextBlock Text="项目阶段" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding PhaseTotal}" FontFamily="Consolas" FontSize="24" Margin="0,7,0,0" /></StackPanel></Border><Border Style="{StaticResource MainGlassPanelStyle}" Margin="5,0"><StackPanel><TextBlock Text="便签" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding NoteTotal}" FontFamily="Consolas" FontSize="24" Margin="0,7,0,0" /></StackPanel></Border><Border Style="{StaticResource MainGlassPanelStyle}" Margin="5,0"><StackPanel><TextBlock Text="快捷启动" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding LauncherTotal}" FontFamily="Consolas" FontSize="24" Margin="0,7,0,0" /></StackPanel></Border><Border Style="{StaticResource MainGlassPanelStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="剪贴板" Style="{StaticResource CaptionStyle}" /><TextBlock Text="{Binding ClipboardTotal}" FontFamily="Consolas" FontSize="24" Margin="0,7,0,0" /></StackPanel></Border></UniformGrid></Grid></UserControl>
