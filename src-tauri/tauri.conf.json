{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DustDesk",
  "version": "../package.json",
  "identifier": "com.dustdesk.next",
  "build": {
    "beforeDevCommand": "npm run dev:tauri:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:tauri:ui",
    "frontendDist": "../out/tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "prototype",
        "workspace",
        "widgets",
        "recovery",
        "capture",
        "pin",
        "quick-capture",
        "runtime-import"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../Assets/DustDesk.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "../Assets/DustDesk.ico",
        "uninstallerIcon": "../Assets/DustDesk.ico",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "DustDesk"
}
