{
  "name": "dustdesk-electron",
  "version": "2.0.0",
  "private": true,
  "author": "DustDesk",
  "description": "DustDesk local desktop workspace rebuilt with Electron.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/**/*.test.mjs",
    "e2e": "npm run build && node tests/e2e-smoke.mjs",
    "e2e:widgets": "npm run build && node tests/widget-restart.mjs",
    "e2e:organizer": "npm run build && node tests/organizer-real.mjs",
    "e2e:visual-special": "npm run build && node tests/visual-special.mjs",
    "e2e:widget-dock": "npm run build && node tests/widget-dock.mjs",
    "e2e:update": "npm run build && node tests/update-local.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "systeminformation": "^5.33.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.dustdesk.next",
    "productName": "DustDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "Assets/DustDesk.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DustDesk-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "DustDesk-${version}-${arch}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Abyxs",
      "repo": "DustDesk-Desktop-Manager"
    }
  }
}
