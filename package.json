{
  "name": "dustdesk-electron",
  "version": "1.0.1",
  "private": true,
  "author": "DustDesk",
  "description": "DustDesk local desktop workspace, rebuilt with Electron.",
  "homepage": "https://github.com/Xu-qingsong/DustDesk-Next",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xu-qingsong/DustDesk-Next.git"
  },
  "bugs": {
    "url": "https://github.com/Xu-qingsong/DustDesk-Next/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/**/*.test.mjs",
    "check:silent": "npm run typecheck && npm test && npm run build && node --test --test-concurrency=1 tests/renderer-headless.mjs tests/screenshot-headless.mjs",
    "test:screenshot:silent": "npm run build && node --test tests/screenshot-document.test.mjs tests/screenshot-main.test.mjs tests/screenshot-headless.mjs",
    "test:renderer:silent": "npm run build && node --test tests/renderer-headless.mjs",
    "e2e": "npm run build && node tests/e2e-smoke.mjs",
    "e2e:widgets": "npm run build && node tests/widget-restart.mjs",
    "e2e:regressions": "npm run build && node tests/logic-regressions.mjs",
    "e2e:review": "npm run build && node tests/review-regressions.mjs",
    "e2e:optimizations": "npm run build && node tests/optimization-regressions.mjs",
    "e2e:features": "npm run build && node tests/feature-completion-regressions.mjs",
    "e2e:productivity": "npm run build && node tests/productivity.mjs",
    "e2e:ui-fixes": "npm run build && node tests/ui-layout-regressions.mjs && node tests/note-drafts.mjs && node tests/search-navigation.mjs && node tests/resource-health-regressions.mjs",
    "e2e:data-editing": "npm run build && node tests/data-editing-regressions.mjs",
    "e2e:screenshot": "npm run build && node tests/screenshot-regressions.mjs",
    "e2e:organizer": "npm run build && node tests/organizer-real.mjs",
    "e2e:visual-special": "npm run build && node tests/visual-special.mjs",
    "e2e:widget-dock": "npm run build && node tests/widget-dock.mjs",
    "e2e:update": "npm run build && node tests/update-local.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "systeminformation": "^5.33.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.dustdesk.next",
    "productName": "DustDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "Assets/DustDesk.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DustDesk-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "DustDesk-${version}-${arch}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Xu-qingsong",
      "repo": "DustDesk-Next"
    }
  }
}
