{
  "name": "dustdesk",
  "version": "1.0.3",
  "private": true,
  "author": "DustDesk",
  "description": "DustDesk desktop workspace built with Rust, Tauri and React.",
  "homepage": "https://github.com/Xu-qingsong/DustDesk-Next",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xu-qingsong/DustDesk-Next.git"
  },
  "bugs": {
    "url": "https://github.com/Xu-qingsong/DustDesk-Next/issues"
  },
  "scripts": {
    "dev:tauri": "tauri dev",
    "dev:tauri:workspace": "tauri dev -- --workspace",
    "dev:tauri:ui": "vite --config vite.tauri.config.ts",
    "build:tauri:ui": "vite build --config vite.tauri.config.ts",
    "build:tauri": "tauri build --no-bundle",
    "test:tauri:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:tauri:lan:compat": "node --test --test-concurrency=1 tests/tauri-lan-compat.mjs",
    "test:tauri:lan:transport": "node --test --test-concurrency=1 tests/tauri-lan-transport.mjs",
    "test:tauri:lan:receive-storage": "node --test --test-concurrency=1 tests/tauri-lan-receive-storage.mjs",
    "test:tauri:lan:legacy-publication": "node --test --test-concurrency=1 tests/tauri-lan-legacy-publication.mjs",
    "test:tauri:lan:ownership": "node --test --test-concurrency=1 tests/tauri-lan-ownership.mjs",
    "test:tauri:lan:receiver": "node --test --test-concurrency=1 tests/tauri-lan-receiver.mjs",
    "test:tauri:lan:sender": "node --test --test-concurrency=1 tests/tauri-lan-sender.mjs",
    "test:tauri:lan:discovery": "node --test --test-concurrency=1 tests/tauri-lan-discovery.mjs",
    "test:tauri:lan:identity": "node --test --test-concurrency=1 tests/tauri-lan-identity.mjs",
    "test:tauri:lan:dialog": "node --test --test-concurrency=1 tests/tauri-lan-dialog.mjs",
    "test:tauri:lan:approvals": "node --test --test-concurrency=1 tests/tauri-lan-approvals.mjs",
    "e2e:tauri:lan": "npm run build:tauri -- --debug && node --test --test-concurrency=1 tests/tauri-lan-host.mjs",
    "e2e:tauri:prototype": "npm run build:tauri -- --debug && node tests/tauri-native.mjs && node tests/tauri-background.mjs",
    "e2e:tauri:internal-drag": "npm run build:tauri -- --debug && node --test tests/tauri-internal-drag.mjs",
    "e2e:tauri:file-drop": "npm run build:tauri -- --debug && node --test tests/tauri-file-drop.mjs",
    "e2e:tauri:screenshot:documents": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-screenshot-documents.mjs",
    "e2e:tauri:screenshot:output": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-screenshot-output.mjs",
    "e2e:tauri:screenshot:drop": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-screenshot-drop.mjs",
    "e2e:tauri:screenshot:window": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-window-capture.mjs",
    "e2e:tauri:screenshot:capture": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-capture-overlay.mjs",
    "e2e:tauri:screenshot:region": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-region-capture.mjs",
    "e2e:tauri:screenshot:editor": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-screenshot-editor.mjs",
    "e2e:tauri:screenshot:pins": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-pins.mjs",
    "e2e:tauri:screenshot:native": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-native-capture.mjs",
    "e2e:tauri:screenshot:lifecycle": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-capture-lifecycle.mjs",
    "e2e:tauri:hotkeys": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-hotkeys.mjs",
    "e2e:tauri:quick-capture": "npm run build && npm run build:tauri -- --debug && node --test tests/tauri-quick-capture.mjs",
    "e2e:tauri:workspace": "npm run build:tauri -- --debug && node tests/tauri-workspace.mjs",
    "e2e:tauri:app": "npm run build:tauri -- --debug && node --test --test-concurrency=1 tests/tauri-entry.mjs tests/tauri-default-app.mjs tests/tauri-app.mjs",
    "e2e:tauri:productivity": "npm run build:tauri -- --debug && node tests/tauri-productivity.mjs && node tests/tauri-productivity-background.mjs",
    "e2e:tauri:backup": "npm run build:tauri -- --debug && node tests/tauri-backup.mjs",
    "e2e:tauri:resources": "npm run build:tauri -- --debug && node tests/tauri-resources.mjs",
    "e2e:tauri:system": "npm run build:tauri -- --debug && node tests/tauri-system.mjs",
    "e2e:tauri:note-images": "npm run build:tauri -- --debug && node tests/tauri-note-images.mjs",
    "e2e:tauri:icons": "npm run build:tauri -- --debug && node tests/tauri-icons.mjs",
    "e2e:tauri:desktop": "npm run build:tauri -- --debug && node tests/tauri-desktop.mjs",
    "e2e:tauri:search": "npm run build:tauri -- --debug && node tests/tauri-search.mjs",
    "e2e:tauri:metrics": "npm run build:tauri -- --debug && node tests/tauri-metrics.mjs",
    "e2e:tauri:startup": "npm run build:tauri -- --debug && node tests/tauri-startup.mjs",
    "e2e:tauri:clipboard": "npm run build:tauri -- --debug && node tests/tauri-clipboard.mjs",
    "e2e:tauri:clipboard:monitor": "npm run build:tauri -- --debug && node tests/tauri-clipboard-monitor.mjs",
    "e2e:tauri:clipboard:shutdown": "npm run build:tauri -- --debug && node tests/tauri-clipboard-shutdown.mjs",
    "e2e:tauri:organizer": "npm run build:tauri -- --debug && node tests/tauri-organizer.mjs",
    "e2e:tauri:organizer:smart": "npm run build:tauri -- --debug && node tests/tauri-organizer-smart.mjs",
    "e2e:tauri:organizer:session": "npm run build:tauri -- --debug && node tests/tauri-organizer-session.mjs",
    "e2e:tauri:identity": "npm run build:tauri -- --debug && node tests/tauri-identity.mjs",
    "e2e:tauri:widgets": "npm run build:tauri -- --debug && node tests/tauri-widgets.mjs",
    "e2e:tauri:widgets:business": "npm run build:tauri -- --debug && node tests/tauri-widget-business.mjs",
    "e2e:tauri:widgets:release": "npm run build:tauri -- --debug && node tests/tauri-widget-release.mjs",
    "e2e:tauri:widgets:events": "npm run build:tauri -- --debug && node tests/tauri-widget-events.mjs",
    "e2e:tauri:widgets:drafts": "npm run build:tauri -- --debug && node tests/tauri-task-drafts.mjs",
    "e2e:tauri:main:release": "npm run build:tauri -- --debug && node tests/tauri-main-release.mjs",
    "e2e:tauri:drafts:format": "npm run build && npm run build:tauri -- --debug && node tests/tauri-draft-format.mjs",
    "e2e:tauri:drafts:export": "npm run build:tauri -- --debug && node --test --test-concurrency=1 tests/tauri-draft-export.mjs",
    "e2e:tauri:drafts:maintenance": "npm run build:tauri -- --debug && node tests/tauri-draft-maintenance.mjs",
    "e2e:tauri:projects:export": "npm run build && npm run build:tauri -- --debug && node tests/tauri-project-export.mjs",
    "e2e:tauri:updates": "npm run build:tauri -- --debug && node tests/tauri-updates.mjs",
    "e2e:tauri:launch:failure": "npm run build:tauri -- --debug && node tests/tauri-launch-failure.mjs",
    "e2e:tauri:toolbox:text": "npm run build && npm run build:tauri -- --debug && node tests/tauri-toolbox-text.mjs",
    "e2e:tauri:toolbox:images": "npm run build && npm run build:tauri -- --debug && node tests/tauri-toolbox-images.mjs",
    "e2e:tauri:organizer:cross-volume": "npm run build:tauri -- --debug && node tests/tauri-organizer-cross-volume.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/**/*.test.mjs",
    "dev": "tauri dev",
    "dev:ui": "vite --config vite.tauri.config.ts",
    "build": "vite build --config vite.tauri.config.ts",
    "build:app": "tauri build --no-bundle",
    "preview": "vite preview --config vite.tauri.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "check:silent": "npm run typecheck && npm test && npm run build && npm run test:rust",
    "check:tauri": "npm run check:silent",
    "e2e": "npm run e2e:tauri:app",
    "dist": "node scripts/package-windows.mjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "playwright": "^1.62.1",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "yauzl": "^3.4.0",
    "selfsigned": "^3.0.1",
    "systeminformation": "^5.33.1",
    "xlsx": "^0.18.5",
    "yazl": "^3.3.1"
  }
}
