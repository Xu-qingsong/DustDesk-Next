<Application x:Class="DustDesk.Next.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DustDesk.Next.Converters"
             xmlns:viewModels="clr-namespace:DustDesk.Next.ViewModels"
             xmlns:views="clr-namespace:DustDesk.Next.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ui:ThemesDictionary Theme="Light" />
                    <ui:ControlsDictionary />
                    <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ArgbToBrushConverter x:Key="ArgbToBrushConverter" />
            <converters:Base64ImageConverter x:Key="Base64ImageConverter" />
            <converters:FileIconConverter x:Key="FileIconConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TasksViewModel}">
                <views:TasksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:NotesViewModel}">
                <views:NotesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProjectsViewModel}">
                <views:ProjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LaunchersViewModel}">
                <views:LaunchersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LinksViewModel}">
                <views:LinksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SearchViewModel}"><views:SearchView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ClipboardViewModel}"><views:ClipboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SystemMonitorViewModel}"><views:SystemMonitorView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}"><views:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:OrganizerViewModel}"><views:OrganizerView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:StatsViewModel}"><views:StatsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
