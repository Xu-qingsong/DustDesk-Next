<UserControl x:Class="DustDesk.Next.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DustDesk.Next.Models">
    <Grid Margin="34,30,34,34" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="剪贴板" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="保留最近复制的文字和图片，重要内容可以固定或锁定。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" />
                <TextBlock Text="{Binding StorageStatusText}" Foreground="{StaticResource DangerBrush}" Margin="0,5,0,0" />
                <TextBlock Text="{Binding ActionStatusText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1"><Button Content="获取当前内容" Command="{Binding CaptureCurrentCommand}" Padding="14,9" /><Button Content="清理普通记录" Command="{Binding ClearCommand}" Padding="16,9" Margin="8,0,0,0" /></WrapPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchInputStyle}" ToolTip="搜索剪贴板历史" /><ComboBox Grid.Column="1" Width="120" Margin="10,0,0,0" SelectedValue="{Binding FilterKind}" SelectedValuePath="Tag"><ComboBoxItem Content="全部" Tag="{x:Null}" /><ComboBoxItem Content="文字" Tag="{x:Static models:ClipboardContentKind.Text}" /><ComboBoxItem Content="图片" Tag="{x:Static models:ClipboardContentKind.Image}" /></ComboBox></Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource MainGlassPanelStyle}" Padding="0">
                <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="18,11"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="4" Padding="8,4"><TextBlock Text="{Binding Kind}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" /></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" MaxHeight="40" /><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm:ss}}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,3,0,0" /></StackPanel><CheckBox Grid.Column="2" Content="固定" IsChecked="{Binding IsPinned}" VerticalAlignment="Center" Margin="6" /><CheckBox Grid.Column="3" Content="锁定" IsChecked="{Binding IsLocked}" VerticalAlignment="Center" Margin="6" /><Button Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" ToolTip="删除" /></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MainGlassPanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="内容预览" Style="{StaticResource SectionTitleStyle}" /><Grid Grid.Row="1" Margin="0,16,0,12"><TextBox Text="{Binding SelectedItem.Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" /><Image Source="{Binding SelectedItem.ImagePath}" Stretch="Uniform" /></Grid><WrapPanel Grid.Row="2"><Button Content="复制回剪贴板" Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedItem}" Style="{StaticResource PrimaryButtonStyle}" /><Button Content="创建任务" Command="{Binding CreateTaskFromSelectedCommand}" CommandParameter="{Binding SelectedItem}" Margin="8,0,0,0" Padding="12,7" /><Button Content="创建便签" Command="{Binding CreateNoteFromSelectedCommand}" CommandParameter="{Binding SelectedItem}" Margin="8,0,0,0" Padding="12,7" /></WrapPanel></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
