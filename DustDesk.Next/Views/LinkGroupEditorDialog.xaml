<ui:FluentWindow x:Class="DustDesk.Next.Views.LinkGroupEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="编辑分组"
                 Width="420"
                 Height="250"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DialogTitle" Text="编辑分组" Style="{StaticResource PageTitleStyle}" FontSize="21" />
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="分组名称" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}" MaxLength="40" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button Content="保存" IsDefault="True" MinWidth="88" Style="{StaticResource PrimaryButtonStyle}" Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
