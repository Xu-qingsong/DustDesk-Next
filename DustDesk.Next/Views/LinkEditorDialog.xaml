<ui:FluentWindow x:Class="DustDesk.Next.Views.LinkEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="编辑链接"
                 Width="520"
                 Height="500"
                 MinWidth="460"
                 MinHeight="450"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DialogTitle" Text="新建链接" Style="{StaticResource PageTitleStyle}" FontSize="22" />
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="名称" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}" MaxLength="120" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="网址" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="UrlBox" Style="{StaticResource InputStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="分类" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <ComboBox x:Name="GroupBox" DisplayMemberPath="Name" Height="34" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="备注" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="NoteBox" Style="{StaticResource InputStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="90" MaxLength="500" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button Content="保存" IsDefault="True" MinWidth="88" Style="{StaticResource PrimaryButtonStyle}" Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
