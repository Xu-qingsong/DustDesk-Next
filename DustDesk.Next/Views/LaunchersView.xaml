<UserControl x:Class="DustDesk.Next.Views.LaunchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop">
    <Grid Margin="34,30,34,34" MaxWidth="1080" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="快捷启动" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="集中打开常用应用、文件和快捷方式，也可以直接拖入。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" /></StackPanel><Button Grid.Column="1" Content="添加项目" Command="{Binding AddLauncherCommand}" Style="{StaticResource PrimaryButtonStyle}" /></Grid>
        <Border Grid.Row="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="5" Padding="14,10" Margin="0,22,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="将文件或快捷方式拖到此页面即可添加（最多 5 项）" Foreground="{StaticResource PrimaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource DangerBrush}" /></Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource MainGlassPanelStyle}" Padding="0"><ListView ItemsSource="{Binding Launchers}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid Margin="18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="36" Height="36" Background="{StaticResource SurfaceMutedBrush}" CornerRadius="5"><Image Source="{Binding Path, Converter={StaticResource FileIconConverter}}" Width="28" Height="28" /></Border><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding Path}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="12,0" /><Button Grid.Column="3" Content="打开" Command="{Binding DataContext.OpenLauncherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="14,8" /><Button Grid.Column="4" Content="更换" Command="{Binding DataContext.ChooseLauncherPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,8" Margin="6,0,0,0" /><Button Grid.Column="5" Content="更多" Command="{Binding DataContext.ShowLauncherMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,8" Margin="6,0" /><Button Grid.Column="6" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Command="{Binding DataContext.DeleteLauncherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" ToolTip="删除" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
    </Grid>
</UserControl>
