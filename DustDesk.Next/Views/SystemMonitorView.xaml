<UserControl x:Class="DustDesk.Next.Views.SystemMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="34,30,34,34" MaxWidth="1180" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="系统检测" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="实时查看这台电脑的资源和网络状态。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" /><WrapPanel Margin="0,14,0,0"><CheckBox Content="CPU" IsChecked="{Binding ShowCpu}" Margin="0,0,16,8" /><CheckBox Content="内存" IsChecked="{Binding ShowMemory}" Margin="0,0,16,8" /><CheckBox Content="下载" IsChecked="{Binding ShowDownload}" Margin="0,0,16,8" /><CheckBox Content="上传" IsChecked="{Binding ShowUpload}" Margin="0,0,16,8" /><CheckBox Content="磁盘读写" IsChecked="{Binding ShowDiskIo}" Margin="0,0,16,8" /><CheckBox Content="磁盘空间" IsChecked="{Binding ShowDiskSpace}" Margin="0,0,16,8" /><CheckBox Content="延迟" IsChecked="{Binding ShowPing}" Margin="0,0,16,8" /><CheckBox Content="运行时长" IsChecked="{Binding ShowUptime}" Margin="0,0,16,8" /></WrapPanel></StackPanel>
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,16,0,14">
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowCpu, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontFamily="Consolas" FontSize="34" Margin="0,14,0,8" /><ProgressBar Value="{Binding CpuPercent}" Height="8" Maximum="100" /></StackPanel></Border>
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowMemory, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="内存" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" FontFamily="Consolas" FontSize="34" Margin="0,14,0,8" /><ProgressBar Value="{Binding MemoryPercent}" Height="8" Maximum="100" /><TextBlock Text="{Binding MemoryText}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" /></StackPanel></Border>
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="2">
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowDownload, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="下载速度" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding DownloadText}" Margin="0,16,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowUpload, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="上传速度" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding UploadText}" Margin="0,16,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowDiskIo, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="磁盘读写" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding DiskIoText}" Margin="0,16,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowDiskSpace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="磁盘空间" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding DiskSpaceStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,16,0,0" Visibility="{Binding ShowDiskSpaceStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DiskSpaces}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DriveName}" FontFamily="Consolas" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SpaceText}" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceText}" />
                                    </Grid>
                                    <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="6" Margin="0,5,0,0" AutomationProperties.Name="{Binding DriveName, StringFormat={}{0} 已用空间}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowPing, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="网络延迟" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding PingText}" FontFamily="Consolas" FontSize="25" Margin="0,16,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource MainGlassPanelStyle}" Margin="0,0,12,12" Visibility="{Binding ShowUptime, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="运行时长" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding UptimeText}" FontFamily="Consolas" FontSize="25" Margin="0,16,0,0" /></StackPanel></Border>
        </UniformGrid>
    </Grid></ScrollViewer>
</UserControl>
