<UserControl x:Class="DustDesk.Next.Views.LinksView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LinkOpenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OpenRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7,0,0,7">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OpenRoot" Property="Background" Value="#78FFFFFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="OpenRoot" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OpenRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter TargetName="OpenRoot" Property="BorderThickness" Value="1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkGroupTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="2,3,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveLine" Height="3" Margin="7,0" VerticalAlignment="Bottom"
                                    Background="Transparent" CornerRadius="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#8FFFFFFF" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#AFFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#7A0F8A72" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#D9FFFFFF" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#BFFFFFFF" />
                                <Setter TargetName="ActiveLine" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,30,34,34" MaxWidth="1120" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="超链接" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="按分组整理常用网址，点击链接即可打开。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" FontSize="14" />
            </StackPanel>
            <Button Grid.Column="1" Content="固定到桌面" Command="{Binding PinWidgetCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="新建链接" Click="AddLink_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="AddGroup_OnClick" Padding="12,7" Margin="0,0,8,0" ToolTip="新增分组">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" /><TextBlock Text="新增分组" /></StackPanel>
            </Button>
            <Button Grid.Column="1" Click="EditGroup_OnClick" Padding="12,7" Margin="0,0,8,0" ToolTip="重命名当前分组">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" /><TextBlock Text="编辑分组" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe Fluent Icons"
                    Command="{Binding DeleteGroupCommand}" CommandParameter="{Binding SelectedGroup}"
                    Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource DangerBrush}" ToolTip="删除当前分组" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource MainGlassPanelStyle}" Padding="0" BorderBrush="Transparent" BorderThickness="0">
            <TabControl ItemsSource="{Binding Groups}"
                        SelectedItem="{Binding SelectedGroup}"
                        ItemContainerStyle="{StaticResource LinkGroupTabStyle}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        BorderThickness="0"
                        Background="Transparent">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LinkCount, StringFormat={}{0} 条}" Style="{StaticResource CaptionStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <ListBox ItemsSource="{Binding Links}"
                                     SelectedItem="{Binding DataContext.SelectedLink, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="False"
                                      Padding="6">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                     <Style TargetType="ListBoxItem">
                                         <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                         <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                         <Setter Property="Padding" Value="0" />
                                         <Setter Property="Margin" Value="4" />
                                         <Setter Property="Background" Value="Transparent" />
                                         <Setter Property="BorderBrush" Value="Transparent" />
                                         <Setter Property="BorderThickness" Value="0" />
                                         <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                         <Setter Property="Template">
                                             <Setter.Value>
                                                 <ControlTemplate TargetType="ListBoxItem">
                                                     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                 </ControlTemplate>
                                             </Setter.Value>
                                         </Setter>
                                     </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="70" BorderThickness="0" BorderBrush="Transparent" CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#A6FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.07" Color="#33434A" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E6FFFFFF" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.11" Color="#33434A" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                                <Button Command="{Binding DataContext.OpenLinkCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Tag="{Binding DataContext, ElementName=Root}"
                                                        Style="{StaticResource LinkOpenButtonStyle}"
                                                        ToolTip="{Binding Note}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                     Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="打开" FontWeight="SemiBold" Command="{Binding Tag.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="编辑" Click="EditLinkMenu_OnClick" />
                                                            <Separator />
                                                            <MenuItem Header="删除" Foreground="{StaticResource DangerBrush}" Command="{Binding Tag.DeleteLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Url}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,3,0,0" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                                                             <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" TextAlignment="Left" TextTrimming="CharacterEllipsis" MaxHeight="18" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe Fluent Icons"
                                                        Style="{StaticResource IconButtonStyle}" ToolTip="编辑链接"
                                                        Click="EditLink_OnClick" Width="34" Height="34" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="当前分组还没有链接" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding LinkCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />
    </Grid>
</UserControl>
