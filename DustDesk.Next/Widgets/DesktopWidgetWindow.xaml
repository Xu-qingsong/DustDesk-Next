<Window x:Class="DustDesk.Next.Widgets.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="300"
        MinHeight="34"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="{StaticResource TextBrush}">
    <Border x:Name="Root" Background="#F5FFFFFF" BorderBrush="#CCD8DEDF" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#18242F" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border x:Name="Header"
                    Background="Transparent"
                    CornerRadius="7,7,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="Header_OnMouseLeftButtonUp"
                    MouseMove="Header_OnMouseMove"
                    LostMouseCapture="Header_OnLostMouseCapture">
                <Grid Margin="10,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="14" Background="{StaticResource PrimaryBrush}" CornerRadius="2" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="OptionsButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Content="&#xE712;"
                            FontFamily="Segoe Fluent Icons"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="组件设置"
                            AutomationProperties.Name="组件设置"
                            Click="OptionsButton_OnClick">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OptionsMenu"
                                         Opened="WidgetMenu_OnOpened"
                                         FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                                         FontSize="12"
                                         MinWidth="196">
                                <ContextMenu.Resources>
                                    <Style x:Key="WidgetOptionMenuItemStyle" TargetType="MenuItem">
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="ItemBackground" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="4,1">
                                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource SurfaceMutedBrush}" /></Trigger>
                                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem x:Name="CollapseMenuItem" Style="{StaticResource WidgetOptionMenuItemStyle}" Click="Collapse_OnClick">
                                    <MenuItem.Header>
                                        <Grid Width="166"><TextBlock x:Name="CollapseMenuText" Text="折叠组件" /></Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="TransparentMenuItem" Style="{StaticResource WidgetOptionMenuItemStyle}" Click="Transparent_OnClick">
                                    <MenuItem.Header>
                                        <Grid Width="166"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="透明背景" /><TextBlock x:Name="TransparentCheck" Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" /></Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="TopMostMenuItem" Style="{StaticResource WidgetOptionMenuItemStyle}" Click="TopMost_OnClick">
                                    <MenuItem.Header>
                                        <Grid Width="166"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="置顶" /><TextBlock x:Name="TopMostCheck" Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" /></Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="AutoCollapseMenuItem" Style="{StaticResource WidgetOptionMenuItemStyle}" Click="AutoCollapse_OnClick">
                                    <MenuItem.Header>
                                        <Grid Width="166"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="10 秒后自动折叠" /><TextBlock x:Name="AutoCollapseCheck" Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" /></Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="LockMenuItem" Style="{StaticResource WidgetOptionMenuItemStyle}" Click="Lock_OnClick">
                                    <MenuItem.Header>
                                        <Grid Width="166"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="锁定位置" /><TextBlock x:Name="LockCheck" Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" /></Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="关闭组件" Style="{StaticResource WidgetOptionMenuItemStyle}" Click="Close_OnClick" Foreground="{StaticResource DangerBrush}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>
            <ContentControl x:Name="WidgetContent" Grid.Row="1" Margin="10,3,10,10" />
            <Button x:Name="SearchOptionsButton"
                    Grid.RowSpan="2" Panel.ZIndex="10"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,7,7,0"
                    Width="28" Height="28" Padding="0"
                    Content="&#xE712;" FontFamily="Segoe Fluent Icons"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="组件设置" AutomationProperties.Name="组件设置"
                    Visibility="Collapsed"
                    Click="SearchOptionsButton_OnClick" />
        </Grid>
    </Border>
</Window>
