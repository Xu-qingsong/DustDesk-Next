<UserControl x:Class="DustDesk.Next.Widgets.TodoWidgetView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding SelectedOpenCount, StringFormat=还有 {0} 项}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedDateText}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE76B;"
                        FontFamily="Segoe Fluent Icons"
                        Command="{Binding PreviousDayCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="前一天" />
                <Button Content="今"
                        Command="{Binding TodayCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="今天"
                        Margin="3,0" />
                <Button Content="&#xE76C;"
                        FontFamily="Segoe Fluent Icons"
                        Command="{Binding NextDayCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="后一天" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputStyle}"
                     ToolTip="新任务标题" />
            <Button Grid.Column="1"
                    Content="&#xE710;"
                    FontFamily="Segoe Fluent Icons"
                    Command="{Binding AddTodoCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="添加任务"
                    Margin="6,0,0,0" />
        </Grid>
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredTodos}"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsCompleted}"
                              Content="{Binding Title}"
                              Margin="4,5"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <CheckBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="删除"
                                          Foreground="#C2414B"
                                          Command="{Binding Tag.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </CheckBox.ContextMenu>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
